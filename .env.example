# The network the board joins on boot, and the country its radio follows.
WIFI_SSID=
WIFI_PASSWORD=
WIFI_COUNTRY=FI

# The password provision.sh gives the board's arduino account.
BOARD_PASSWORD=

# Board tokens are derived from this; it must match the server's value.
DEVICE_SECRET=

SERVER_URL=https://arduino.danielbacsur.dev

# Web app only: direct Gemini rule compilation (no per-frame API calls).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Web app only: optional self-hosted ntfy endpoint and publish token.
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=
