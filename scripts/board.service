# App CLI starts a default app only once per boot and gives up if that
# attempt fails, so systemd keeps trying until the app is up instead.
[Unit]
Description=Board camera app
After=arduino-app-cli.service docker.service arduino-router.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=arduino
ExecStart=/usr/bin/arduino-app-cli app restart user:board
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
